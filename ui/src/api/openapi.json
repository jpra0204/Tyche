  "info": {
    "title": "Tyche console",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/backtests": {
      "get": {
        "description": "Every recorded backtest in the workspace, newest first.",
        "operationId": "listBacktests",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tyche-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tyche-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BacktestSummary"
                  },
                  "title": "Response Listbacktests",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Backtests"
      }
    },
    "/api/backtests/{run_id}/report": {
      "get": {
