              },
              {
                "type": "null"
              }
            ],
            "title": "First"
          },
          "halted": {
            "default": false,
            "title": "Halted",
            "type": "boolean"
          },
          "has_report": {
            "default": false,
            "title": "Has Report",
            "type": "boolean"
          },
          "last": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last"
