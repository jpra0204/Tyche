                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tyche-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
