      "BacktestRequest": {
        "additionalProperties": false,
        "description": "``tyche backtest``: the configured strategies on cached history.",
        "properties": {
          "command": {
            "const": "backtest",
            "title": "Command",
            "type": "string"
          },
          "first": {
            "format": "date",
            "title": "First",
            "type": "string"
          },
          "last": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last"
          },
          "risk_profile": {
            "default": "default",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
            "title": "Risk Profile",
            "type": "string"
          }
        },
        "required": [
          "command",
          "first"
        ],
        "title": "BacktestRequest",
        "type": "object"
      },
      "BacktestSummary": {
        "description": "One recorded backtest, from its ``run.json`` and ``metrics.json``.\n\nFractions are strings as ``metrics.json`` writes them (``\"0.081234\"`` is 8.12%).\nWhen the record cannot be read, ``error`` says why and the rest may be empty.",
