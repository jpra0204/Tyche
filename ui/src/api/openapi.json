    "/api/runs": {
      "post": {
        "description": "Start a ``tyche`` command; refused while another is running.",
        "operationId": "startRun",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tyche-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tyche-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "discriminator": {
                  "mapping": {
                    "backtest": "#/components/schemas/BacktestRequest",
                    "data_fetch": "#/components/schemas/FetchRequest",
                    "report": "#/components/schemas/ReportRequest"
                  },
                  "propertyName": "command"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/FetchRequest"
                  },
                  {
                    "$ref": "#/components/schemas/BacktestRequest"
                  },
                  {
                    "$ref": "#/components/schemas/ReportRequest"
                  }
                ],
                "title": "Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Run"
      }
    },
